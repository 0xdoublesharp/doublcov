{
  "name": "@0xdoublesharp/doublcov-web",
  "version": "0.4.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vue-tsc -b && vite build",
    "clean": "rm -rf dist dist-types *.tsbuildinfo",
    "dev": "vite --host 0.0.0.0",
    "test": "vitest run",
    "test:fuzz": "vitest run test/fuzz.test.ts",
    "typecheck": "vue-tsc -b"
  },
  "dependencies": {
    "@0xdoublesharp/doublcov-core": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-vue": "6.0.8",
    "shiki": "^4.4.3",
    "tailwindcss": "4.3.3",
    "vite": "8.3.0",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.5.0",
    "happy-dom": "^20.14.5",
    "vue-tsc": "latest"
  }
}
