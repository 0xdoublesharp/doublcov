{
  "name": "@0xdoublesharp/doublcov-web",
  "version": "0.4.6",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vue-tsc -b && vite build",
    "clean": "rm -rf dist dist-types *.tsbuildinfo",
    "dev": "vite --host 0.0.0.0",
    "test": "vitest run",
    "test:fuzz": "vitest run test/fuzz.test.ts",
    "typecheck": "vue-tsc -b"
  },
  "dependencies": {
    "@0xdoublesharp/doublcov-core": "workspace:*",
    "@tailwindcss/vite": "4.3.5",
    "@vitejs/plugin-vue": "6.0.10",
    "shiki": "^4.6.0",
    "tailwindcss": "4.3.5",
    "vite": "8.3.6",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.4",
    "vue-tsc": "^3.3.14"
  }
}
